# Copy to backend/.env (or export in your shell). Never commit real .env files.

# Backend (read by pydantic-settings, prefix PIXELGPU_)
PIXELGPU_ENVIRONMENT=development
PIXELGPU_HOST=127.0.0.1
PIXELGPU_PORT=8000
PIXELGPU_LOG_LEVEL=info
# JSON list. Only needed when the frontend is served from a different origin
# than the backend and not through the Vite proxy.
PIXELGPU_CORS_ORIGINS=[]
# Register the built-in simulated fleet (6 GPUs on 2 workers). Set false for an empty fleet.
PIXELGPU_SIMULATED_FLEET=true

# Frontend dev server: where Vite proxies /api requests.
PIXELGPU_BACKEND_URL=http://127.0.0.1:8000
# Frontend build: override the API base URL (defaults to same-origin /api).
# VITE_API_BASE_URL=http://127.0.0.1:8000/api
